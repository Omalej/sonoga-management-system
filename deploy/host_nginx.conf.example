# Host-level HTTPS reverse proxy for manage.sonogahotels.com.
# Obtain/install a valid TLS certificate before enabling the 443 server.

server {
    listen 80;
    listen [::]:80;
    server_name manage.sonogahotels.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name manage.sonogahotels.com;

    ssl_certificate     /etc/letsencrypt/live/manage.sonogahotels.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/manage.sonogahotels.com/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
    }
}
