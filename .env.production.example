DJANGO_ENV=production
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=manage.sonogahotels.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://manage.sonogahotels.com
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=sonoga_hms
POSTGRES_USER=sonoga
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_TRUST_X_FORWARDED_PROTO=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

SONOGA_WORDPRESS_API_KEY=REPLACE_WITH_LONG_RANDOM_WEBHOOK_SECRET
SONOGA_WORDPRESS_USER=wordpress-sync
SONOGA_WORDPRESS_REQUIRE_SIGNATURE=True
SONOGA_WORDPRESS_SIGNATURE_TOLERANCE=300
SONOGA_WORDPRESS_ALLOWED_IPS=
SONOGA_WORDPRESS_TRUST_PROXY_IP_HEADERS=True

# Initial build only. Once real migration files are generated and committed,
# set this to False for normal deployments.
SONOGA_AUTO_MAKEMIGRATIONS=False

SONOGA_HTTP_PORT=8080
SONOGA_BACKUP_RETENTION_DAYS=14
